{
  "name": "hass-anycubic-cloud-panel",
  "version": "0.9.31",
  "description": "anycubic panel for hass",
  "main": "src/index.ts",
  "scripts": {
    "check-types": "tsc --noemit",
    "build": "npm run lint && npm run rollup",
    "build:quick": "npm run rollup",
    "build_card": "npm run lint && npm run rollup_card",
    "build_card:quick": "npm run rollup_card",
    "rollup": "rollup -c",
    "rollup_card": "rollup -c rollup.config-card.mjs",
    "eslint": "eslint src --ext .ts,.js -c .eslintrc.js --ignore-pattern src/lib",
    "lint": "npm run eslint && npm run check-types",
    "prettier": "prettier src/components/**/*.ts --write",
    "start": "rollup -c --watch",
    "lint:fix": "npm run eslint -- --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@date-fns/utc": "^2.1.0",
    "@eslint/js": "^9.7.0",
    "@lit-labs/motion": "^1.0.7",
    "@lit-labs/observers": "^2.0.2",
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "date-fns": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-lit": "^1.14.0",
    "eslint-plugin-prettier": "^5.2.1",
    "home-assistant-js-websocket": "^9.4.0",
    "intl-messageformat": "^10.5.14",
    "lit": "^3.1.4",
    "lit-html": "^3.3.3",
    "modern-color": "^1.1.3",
    "prettier": "^3.3.3",
    "rollup": "^4.50.2",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.43.0"
  }
}
