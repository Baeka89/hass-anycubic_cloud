  "options": {
    "step": {
      "card_config": {
        "title": "Panel Card Config",
        "data": {
          "card_config": "Panel Card Config (YAML format)",
          "enable_panel": "Show sidebar panel"
        },
        "description": "Optional: customizes how the printer card looks in the sidebar panel. Leaving it empty/\"null\" is completely fine - the defaults apply (see below).\n\nTIP: Instead of typing YAML here by hand, you can also add the card normally via \"Edit Dashboard -> Add Card -> Anycubic Printer Card\" on any dashboard - that gives you a real settings dialog with toggles/dropdowns. This box here is only for the sidebar panel card, which has no visual editor.\n\nPossible keys (all optional):\nvertical (true/false, default: false) - portrait instead of landscape layout\nround (true/false, default: false) - round values to whole numbers\nuse_24hr (true/false, default: true) - 24-hour instead of 12-hour time format\ntemperatureUnit (C or F, default: C)\nscaleFactor (number, default: 1) - size of the animated printer graphic\nalwaysShow (true/false, default: false) - keep showing the card even when the printer is offline/idle\nshowSettingsButton (true/false, default: false) - show a gear icon on the card\nlightEntityId - entity_id of an EXISTING Home Assistant light (e.g. a room light near the printer) that can then be toggled directly from the card - NOT the printer's own light\npowerEntityId - entity_id of an existing outlet/switch, also toggleable directly from the card\ncameraEntityId - entity_id of an existing camera entity for a live preview on the card\nslotColors - list of custom hex colors for the ACE filament slots\nmonitoredStats (list, default: Status, ETA, Elapsed, Remaining) - which values appear on the card. Valid values: Status, Online, Availability, Project, Layer, ETA, Elapsed, Remaining, Hotend, Bed, T Hotend, T Bed, Dry Status, Dry Time, Speed Mode, Fan Speed, On Time, Off Time, Bottom Time, Model Height, Bottom Layers, Z Up Height, Z Up Speed, Z Down Speed\n\nCopy-paste examples (YAML format, no curly braces):\n\n- Just change units (Fahrenheit, 12-hour clock):\ntemperatureUnit: F\nuse_24hr: false\n\n- Also show fan speed and speed mode:\nmonitoredStats:\n  - Status\n  - ETA\n  - Elapsed\n  - Remaining\n  - Fan Speed\n  - Speed Mode\n\n- Make an existing room light + outlet toggleable from the card:\nlightEntityId: light.workshop_ceiling\npowerEntityId: switch.printer_outlet\n\n- Portrait layout, always visible, with gear button and custom slot colors:\nvertical: true\nalwaysShow: true\nshowSettingsButton: true\nslotColors:\n  - \"#ff0000\"\n  - \"#00ff00\"\n  - \"#0000ff\"\n  - \"#ffff00\""
      },
      "debug": {
        "title": "Debug Settings",
        "data": {
          "debug_mqtt_msg": "Debug Log all MQTT messages",
          "debug_api_calls": "Debug Log all API calls"
        }
      },
      "mqtt_presets": {
        "title": "MQTT Connection & Drying Presets",
        "description": "MQTT connect mode: controls when the integration keeps a live connection to the printer (instead of only polling the cloud every ~60s).\n\nDrying presets: store up to 5 fixed duration (hours) + temperature (°C) combinations here. Each preset then shows up as its own 'Drying Preset 1-5' button on the printer/ACE device - pressing it starts drying immediately with exactly these values, no need to set anything first.",
        "data": {
          "mqtt_connect_mode": "MQTT connect mode",
          "drying_preset_duration_1": "Preset 1: duration (hours)",
          "drying_preset_temperature_1": "Preset 1: temperature (°C)",
          "drying_preset_duration_2": "Preset 2: duration (hours)",
          "drying_preset_temperature_2": "Preset 2: temperature (°C)",
          "drying_preset_duration_3": "Preset 3: duration (hours)",
          "drying_preset_temperature_3": "Preset 3: temperature (°C)",
          "drying_preset_duration_4": "Preset 4: duration (hours)",
          "drying_preset_temperature_4": "Preset 4: temperature (°C)",
          "drying_preset_duration_5": "Preset 5: duration (hours)",
          "drying_preset_temperature_5": "Preset 5: temperature (°C)",
          "update_retry_count": "Update retries per cycle",
          "mqtt_verify_tls": "Verify MQTT server certificate and hostname"
        },
        "data_description": {
          "mqtt_connect_mode": "How aggressively the integration keeps a live MQTT connection to the printer open.",
          "drying_preset_duration_1": "How long 'Drying Preset 1' dries for.",
          "drying_preset_temperature_1": "What temperature 'Drying Preset 1' dries at.",
          "drying_preset_duration_2": "How long 'Drying Preset 2' dries for.",
          "drying_preset_temperature_2": "What temperature 'Drying Preset 2' dries at.",
          "drying_preset_duration_3": "How long 'Drying Preset 3' dries for.",
          "drying_preset_temperature_3": "What temperature 'Drying Preset 3' dries at.",
          "drying_preset_duration_4": "How long 'Drying Preset 4' dries for.",
          "drying_preset_temperature_4": "What temperature 'Drying Preset 4' dries at.",
          "drying_preset_duration_5": "How long 'Drying Preset 5' dries for.",
          "drying_preset_temperature_5": "What temperature 'Drying Preset 5' dries at.",
          "update_retry_count": "How many times a failed cloud update cycle is retried (with exponential backoff: 1s, 2s, 4s, ...) before it counts as failed. 0 disables retries (old behavior).",
          "mqtt_verify_tls": "Enabled by default. Disable only to explicitly use compatibility mode without server verification and with a broader cipher selection. The connection remains encrypted, but the server identity is not verified. No automatic fallback; saving reloads the integration."
        }
      }
    }
  },
